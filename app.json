{
  "expo": {
    "name": "Oisiu",
    "slug": "oisiu",
    "scheme": "oisiu",
    "version": "1.7.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/app/icon.png",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app/splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#F3E8D7",
          "dark": {
            "image": "./assets/app/splash.png",
            "backgroundColor": "#1E1719"
          }
        }
      ],
      "expo-system-ui",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oisiu.app"
    },
    "android": {
      "package": "com.oisiu.app",
      "versionCode": 10,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "backgroundColor": "#F3E8D7"
  }
}
