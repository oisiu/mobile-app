{
  "name": "@oisiu/mobile-app",
  "version": "1.13.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oisiu/mobile-app.git"
  },
  "bugs": {
    "url": "https://github.com/oisiu/mobile-app/issues"
  },
  "homepage": "https://github.com/oisiu/mobile-app#readme",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:release",
    "test:coverage": "vitest run --coverage && pnpm test:release",
    "lint": "eslint . --max-warnings=0",
    "deadcode": "knip",
    "doctor": "expo-doctor .",
    "audit": "pnpm audit --prod --audit-level high --ignore-unfixable",
    "deps:check": "node scripts/check-dependencies.cjs",
    "verify": "pnpm deps:check && pnpm typecheck && pnpm lint && pnpm deadcode && pnpm test:coverage",
    "test:release": "node --test tests/release/*.cjs",
    "test:release:signing": "node tests/native/release-signing.cjs"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.31",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "knip": "^6.37.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
