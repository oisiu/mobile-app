{
  "name": "@oisiu/mobile-app",
  "version": "1.5.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oisiu/mobile-app.git"
  },
  "bugs": {
    "url": "https://github.com/oisiu/mobile-app/issues"
  },
  "homepage": "https://github.com/oisiu/mobile-app#readme",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "deadcode": "knip",
    "doctor": "expo-doctor .",
    "audit": "pnpm audit --prod --audit-level high --ignore-unfixable",
    "verify": "pnpm typecheck && pnpm lint && pnpm deadcode && pnpm test:coverage"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~58.0.0-preview.5",
    "expo-clipboard": "~58.0.1",
    "expo-constants": "~58.0.5",
    "expo-document-picker": "~58.0.1",
    "expo-file-system": "~58.0.1",
    "expo-font": "~58.0.2",
    "expo-haptics": "~58.0.1",
    "expo-linking": "~58.0.5",
    "expo-router": "~58.0.6",
    "expo-sharing": "~58.0.8",
    "expo-splash-screen": "~58.0.1",
    "expo-sqlite": "~58.0.4",
    "expo-status-bar": "~58.0.1",
    "expo-system-ui": "~58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.2",
    "expo-doctor": "1.20.4",
    "knip": "^6.35.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
